generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  email           String
  phone           String?
  logo            String?
  address         String?
  city            String?
  state           String?
  plan            String   @default("starter")
  isActive        Boolean  @default(true)
  maxUsers        Int      @default(10)
  maxJobs         Int      @default(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  settings  Setting[]
  departments    Department[]
  branches       HospitalBranch[]
  jobs           Job[]
  candidates     Candidate[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  templates      Template[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  email     String
  password  String
  role      String   @default("hr_executive")
  avatar    String?
  department String?
  phone     String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates     Candidate[]    @relation("AssignedHR")
  remarks        Remark[]
  communications Communication[]
  statusHistory  StatusHistory[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([role])
}

model Department {
  id              String   @id @default(cuid())
  tenantId        String?
  name            String
  code            String
  head            String?
  totalPositions  Int      @default(0)
  openPositions   Int      @default(0)
  color           String   @default("#6B7280")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs   Job[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model HospitalBranch {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  code      String
  address   String
  city      String
  state     String
  phone     String
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs   Job[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Job {
  id                 String   @id @default(cuid())
  tenantId           String?
  title              String
  departmentId       String
  branchId           String
  location           String
  employmentType     String   @default("full_time")
  experienceRequired String
  salaryMin          Int
  salaryMax          Int
  qualification      String
  skills             String[]
  vacancies          Int      @default(1)
  description        String
  responsibilities   String[]
  benefits           String[]
  expiryDate         String?
  hiringManager      String
  status             String   @default("open")
  applyLink          String?
  isUrgent           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant     Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department     @relation(fields: [departmentId], references: [id])
  branch     HospitalBranch @relation(fields: [branchId], references: [id])
  candidates Candidate[]

  @@index([tenantId])
  @@index([status])
  @@index([departmentId])
  @@index([branchId])
}

model Candidate {
  id                  String   @id @default(cuid())
  tenantId            String?
  applicationNumber   String
  photo               String?
  fullName            String
  gender              String
  dob                 String?
  email               String
  mobile              String
  whatsapp            String
  whatsappVerified    Boolean  @default(false)
  emailVerified       Boolean  @default(false)
  address             String?
  city                String?
  state               String?
  pin                 String?
  qualification       String?
  experience          String?
  currentEmployer     String?
  currentSalary       Int      @default(0)
  expectedSalary      Int      @default(0)
  noticePeriod        String?
  preferredDepartment String?
  preferredLocation   String?
  languages           String[]
  skills              String[]
  linkedIn            String?
  portfolio           String?
  coverLetter         String?
  resumeUrl           String?
  certificates        String[]
  jobId               String
  applicationDate     DateTime @default(now())
  status              String   @default("new")
  assignedHRId        String?
  tags                String[]
  isFutureCandidate   Boolean  @default(false)
  isBlacklisted       Boolean  @default(false)
  isFavorite          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job      Job        @relation(fields: [jobId], references: [id])
  assignedHR User?    @relation("AssignedHR", fields: [assignedHRId], references: [id])

  score          CandidateScore?
  remarks        Remark[]
  communications Communication[]
  statusHistory  StatusHistory[]
  interviews     InterviewRecord[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([status])
  @@index([jobId])
  @@index([assignedHRId])
  @@index([applicationDate])
}

model CandidateScore {
  id                 String   @id @default(cuid())
  candidateId        String   @unique
  communication      Int      @default(0)
  technicalSkill     Int      @default(0)
  experience         Int      @default(0)
  qualification      Int      @default(0)
  personality        Int      @default(0)
  hospitalCultureFit Int      @default(0)
  computerKnowledge  Int      @default(0)
  leadership         Int      @default(0)
  confidence         Int      @default(0)
  overall            Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Remark {
  id          String   @id @default(cuid())
  candidateId String
  userId      String
  type        String   @default("overall")
  content     String
  isPinned    Boolean  @default(false)
  colorLabel  String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([candidateId])
}

model Communication {
  id          String   @id @default(cuid())
  candidateId String
  userId      String?
  type        String
  direction   String
  content     String
  status      String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([candidateId])
}

model StatusHistory {
  id          String   @id @default(cuid())
  candidateId String
  userId      String
  fromStatus  String?
  toStatus    String
  remarks     String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([candidateId])
}

model InterviewRecord {
  id            String   @id @default(cuid())
  tenantId      String?
  candidateId   String
  jobId         String?
  type          String   @default("online")
  date          String
  time          String
  location      String?
  meetLink      String?
  zoomLink      String?
  panelMembers  String[]
  notes         String?
  status        String   @default("scheduled")
  reminderSent  Boolean  @default(false)
  rating        Int?
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([candidateId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String?
  type        String
  title       String
  message     String
  read        Boolean  @default(false)
  candidateId String?
  actionUrl   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  action    String
  entity    String
  entityId  String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Template {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  type      String
  subject   String?
  content   String
  variables String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}
